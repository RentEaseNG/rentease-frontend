# ── Backend API ────────────────────────────────────────────────
# Base URL of the RentEase backend REST API (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Base URL for the Socket.io server (usually the same host, no path)
VITE_SOCKET_URL=http://localhost:5000

# ── Cloudinary (image uploads) ─────────────────────────────────
# Found at: https://console.cloudinary.com → Settings → API Keys
VITE_CLOUDINARY_CLOUD_NAME=

# Create an unsigned upload preset at:
# Cloudinary Console → Settings → Upload → Upload presets → Add preset
VITE_CLOUDINARY_UPLOAD_PRESET=